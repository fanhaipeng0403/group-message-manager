# Copy to deploy/.env on the server (never commit .env).

# External Postgres reachable from the API container (e.g. docker bridge gateway 172.17.0.1:5432)
DATABASE_URL=postgres://group_message_mgr:CHANGE_ME@172.17.0.1:5432/group_message_manager

JWT_SECRET=change-me-min-16-chars-for-production
WEB_ORIGIN=http://YOUR_PUBLIC_HOST:15173

# Optional DashScope (mock script when unset)
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# Web image build args (public URLs the browser will use)
VITE_API_URL=http://YOUR_PUBLIC_HOST:13000
VITE_WS_URL=ws://YOUR_PUBLIC_HOST:13000/ws
